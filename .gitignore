.DS_Store

# dependencies
node_modules/

# build outputs
dist/
*.tsbuildinfo

# env
.env
.env.*
!.env.example

# coverage
coverage/

# bun
bun.lockb
.bun-cache/

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
Thumbs.db

# terraform
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/terraform.tfvars
infra/terraform/.terraform.tfstate.lock.info

# logs
*.log
npm-debug.log*

# secrets that must never be committed
# A GitHub App private key was placed at the repository root twice (2026-09-04
# and 2026-09-05), both times mode 644 and NOT ignored — one `git add -A` away
# from being published. Keep keys outside the repo; this pattern is the net
# that catches the mistake when they are not.
*.pem
*.p12
*.key
