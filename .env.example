# cloud-run-dsh local development environment variables (task B).
#
# Copy to `.env` only if your tooling needs it; the compose file has its own
# dev defaults and the migration runner / agent-host read the real process env.
#
# Legend:
#   [db]        needed for Postgres + migrations (level 1: `docker compose up -d postgres` + `bun run db:migrate`)
#   [host-db]   needed to run agent-host far enough to touch the database (level 2: DB-backed paths)
#   [full]      only meaningful in a real Cloud Run environment — CANNOT be satisfied locally
#   CHANGE_ME   no safe default; must be replaced
#   n/a-locally impossible to provide on a local machine; see docs/local-development.md

# ---------------------------------------------------------------------------
# Level 1: docker compose Postgres + migrations (all you need for `db:migrate`)
# ---------------------------------------------------------------------------

# [db] Postgres connection string used by `bun run db:migrate`
# (infra/migrations/runner.ts) and by the agent-host DB-backed paths.
DATABASE_URL=postgres://dsh:dsh@localhost:5432/dsh

# [db] docker-compose.yml credential defaults. Change them here or export
# overrides before `docker compose up` if you deviate.
POSTGRES_USER=dsh
POSTGRES_PASSWORD=dsh
POSTGRES_DB=dsh
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Level 2: agent-host DB-backed paths (repository, lease store, state store)
#
# With a live Postgres and these values set, `bun run
# apps/agent-host/src/index.ts` reaches `createProductionDependencies()`,
# connects to Postgres, and would start the recovery path — but it then needs
# GCS + GitHub + the sandbox CLI, so a FULL local bootstrap is impossible.
# ---------------------------------------------------------------------------

# [host-db] ID of the workspace this instance serves (Cloud Run restart path
# re-reads it on every boot).
WORKSPACE_ID=ws-local-dev

# [host-db] Local HTTP port for the Agent Gateway.
PORT=8080

# [host-db] Root directory for workspace files. Locally point it at a scratch
# directory; in Cloud Run it is the bind-mounted /workspace.
WORKSPACE_ROOT=./.local/workspace

# [full] GCS bucket for workspace checkpoint bundles. Real GCS access needs
# Application Default Credentials; nothing local can stand in for it here.
CHECKPOINT_BUCKET=n/a-locally-real-gcs-bucket-required

# Optional GCS access-token escape hatch (last resort after the metadata
# server and ADC). Unset by default: on Cloud Run the token comes from the
# metadata server, locally from ADC (`gcloud auth application-default
# login`). Set it only for scripts/CI without ADC.
# GCP_ACCESS_TOKEN=

# [full] KMS-style key reference for checkpoint encryption used in production.
CHECKPOINT_KEY=n/a-locally-real-kms-key-required

# [full] GitHub App credentials for the credential broker (token exchange).
GITHUB_APP_ID=CHANGE_ME
GITHUB_APP_PRIVATE_KEY_PEM=n/a-locally-real-github-app-private-key-required

# [full] Target repository the workspace operates on.
REPOSITORY_OWNER=CHANGE_ME
REPOSITORY_NAME=CHANGE_ME
BASE_BRANCH=main

# [full] Identity of the controller allowed to hold the controller lease.
CONTROLLER_ID=CHANGE_ME

# [host-db] End-user identity recorded on sessions.
USER_ID=local-dev-user

# [full] Cloud Run Instance name this host manages.
INSTANCE_NAME=n/a-locally

# [full] GCP project/region for the Cloud Run Instances API.
GCP_PROJECT_ID=CHANGE_ME
GCP_REGION=asia-northeast1

# [full] Path to the `sandbox` CLI. In Cloud Run this binary is provided by
# the platform at /usr/local/gcp/bin/sandbox; it does not exist on local
# machines, so sandbox execution cannot work locally.
SANDBOX_CLI_PATH=n/a-locally-cloud-run-provided

# [full] Set only in sandboxed Cloud Run deployments that allow egress.
SANDBOX_ALLOW_EGRESS=
